FROM php:8.3.0-cli

WORKDIR /var/www

RUN apt-get update && apt-get install -y \
    build-essential \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libpq-dev \
    locales \
    zip \
    libzip-dev \
    unzip \
    git \
    curl \
    libxml2-dev

RUN apt-get install -y $PHPIZE_DEPS

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install gd \
    && docker-php-ext-install zip bcmath \
    && docker-php-ext-configure zip \
    && docker-php-ext-install pdo_pgsql \
    && docker-php-ext-install pdo_mysql \
    && pecl install xdebug && docker-php-ext-enable xdebug \
    && pecl install swoole \
    && docker-php-ext-enable swoole \
    && curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer \
    && composer self-update

RUN apt-get install -y --no-install-recommends supervisor

RUN docker-php-ext-configure pcntl --enable-pcntl \
    && docker-php-ext-install pcntl

RUN apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 www
RUN useradd -u 1000 -ms /bin/bash -g www www

# Copiar configuração do Supervisor
COPY ./.docker/supervisor/supervisord.conf /etc/supervisor/
COPY ./.docker/supervisor/conf.d/laravel-worker.conf /etc/supervisor/conf.d/
COPY ./.docker/supervisor/conf.d/laravel-server.conf /etc/supervisor/conf.d/
COPY ./.docker/php/local.ini /usr/local/etc/php/php.ini

# Expor a porta padrão do PHP-FPM
EXPOSE 9000 9001 80

COPY . /var/www
COPY --chown=www:www . /var/www
USER www

# Comando padrão para iniciar Supervisor (que gerencia PHP-FPM e workers)
CMD ["supervisord", "-c", "/etc/supervisor/supervisord.conf"]
