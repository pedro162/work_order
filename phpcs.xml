<?xml version="1.0"?>
<ruleset name="PSR12-Project">
    <description>Padrão PSR-12 para o projeto.</description>

    <!-- Define o padrão PSR-12 -->
    <rule ref="PSR12"/>

    <!-- Pastas que serão analisadas -->
    <file>app</file>
    <file>routes</file>
    <file>tests</file>

    <!-- Pastas ignoradas -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/bootstrap/cache/*</exclude-pattern>
    <exclude-pattern>*.blade.php</exclude-pattern>

    <!-- Mostra cores e progresso no terminal -->
    <arg name="colors"/>
    <arg value="sp"/>
</ruleset>
